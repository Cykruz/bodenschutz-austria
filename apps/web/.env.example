# Website (apps/web). Kopie als .env.local anlegen.

# Öffentliche Adresse der Website (Canonical, Sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interne Adresse der API für die Weiterleitung /api/* (Server-seitig, nicht im Browser sichtbar)
API_INTERNAL_URL=http://localhost:4000

# Beispieldaten statt echter API (nur für Entwicklung/Vorführung ohne Backend)
NEXT_PUBLIC_MOCK_API=false

# Direkter Android-APK-Link für /app (leer lassen, wenn nicht vorhanden)
NEXT_PUBLIC_ANDROID_APK_URL=
