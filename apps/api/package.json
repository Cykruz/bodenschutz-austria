{
  "name": "@bodenschutz/api",
  "version": "0.1.0",
  "private": true,
  "description": "Bodenschutz Austria – Backend: Fastify + Prisma (SQLite), KI, PDF, E-Mail, Admin",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:setup": "tsx scripts/db.ts setup",
    "db:reset": "tsx scripts/db.ts reset",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bodenschutz/rules": "file:../../packages/rules",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.3",
    "nodemailer": "^7.0.0",
    "pdfkit": "^0.17.1",
    "pino-pretty": "^13.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.2",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
