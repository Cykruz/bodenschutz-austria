# Kopie als .env anlegen. Werte mit EXPO_PUBLIC_ sind im App-Bundle sichtbar (keine Geheimnisse!).
# Basis-URL der API. Für Expo Go am Handy die LAN-IP des Rechners eintragen, nicht localhost.
# Für EAS-Builds steht die Adresse je Profil in eas.json (preview: Demo-Server, production: Live-Domain).
EXPO_PUBLIC_API_URL=http://localhost:4000
# true = Beispieldaten aus src/lib/mock.ts statt echter API (zum Ausprobieren ohne Backend)
EXPO_PUBLIC_MOCK_API=false
