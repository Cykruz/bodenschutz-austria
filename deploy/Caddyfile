# Caddy-Konfiguration für Bodenschutz Austria.
# Umgebungsvariablen (aus docker-compose.yml): DOMAIN, ACME_EMAIL, ADMIN_ALLOW_IPS.
# Caddy holt und erneuert das Let's-Encrypt-Zertifikat automatisch; dafür müssen Port 80 und 443
# von außen erreichbar sein und die DNS-Einträge für DOMAIN und www.DOMAIN auf diesen Server zeigen.

{
	email {$ACME_EMAIL:info@bodenschutz-austria.at}
	# Caddy soll sich nicht selbst im Header verraten
	servers {
		trusted_proxies static private_ranges
	}
}

# www → Hauptdomain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		-Server
		-X-Powered-By
	}

	# Optionaler Vorab-Zugang für den Testbetrieb (nur Mario und Techniker): BASIC_AUTH_USER und BASIC_AUTH_HASH in der .env setzen,
	# der Container-Start legt dann /etc/caddy/gate.d/gate.caddy an (Passwortabfrage für alles außer /api/health, dazu noindex).
	@gate not path /api/health
	import /etc/caddy/gate.d/*.caddy

	# Optionale IP-Allowlist für die Verwaltung (Seiten und Admin-API).
	# ADMIN_ALLOW_IPS leer lassen (Standard "0.0.0.0/0 ::/0") = kein Filter, Login schützt.
	@admin_blocked {
		path /admin /admin/* /api/admin/*
		not remote_ip {$ADMIN_ALLOW_IPS:0.0.0.0/0 ::/0}
	}
	respond @admin_blocked "Zugriff auf die Verwaltung ist von dieser Adresse nicht erlaubt." 403

	# API direkt an Fastify (Uploads bis 8 MB plus Reserve)
	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:4000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Alles andere an Next.js
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
		level INFO
	}
}
