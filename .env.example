# Kopiere diese Datei nach .env und fülle die Werte aus. Die .env kommt NIE ins Repository.

# --- KI (Anthropic) ---
# Schlüssel unter https://console.anthropic.com erstellen. Ohne Schlüssel läuft alles außer KI-Antworten (es erscheinen Hinweistexte).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Datenbank (SQLite-Datei, wird automatisch angelegt) ---
DATABASE_URL=file:./data/app.db

# --- Server ---
API_PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Zufälliger Text mit mindestens 32 Zeichen, z. B. aus: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bitte-durch-32-zufallszeichen-ersetzen

# --- Verwaltung (erster Admin-Benutzer, wird beim Seed angelegt) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern

# --- E-Mail senden (SMTP) ---
# Lokal zum Testen: MailDev (npm run dev startet ihn mit), Postfach-Ansicht unter http://localhost:1080
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bodenschutz Austria <office@bodenschutz-austria.at>"

# --- E-Mail lesen (IMAP, Marios Postfach) ---
# Leer lassen = Postfach-Worker aus. Für Gmail: imap.gmail.com, Port 993, App-Passwort nötig.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SECONDS=60

# --- Website ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Betrieb mit Docker (docker-compose.yml, deploy/) ---
# Domain ohne https://, DNS für DOMAIN und www.DOMAIN muss auf den Server zeigen
DOMAIN=bodenschutz-austria.at
# Kontaktadresse für Let's Encrypt (Ablaufwarnungen)
ACME_EMAIL=info@bodenschutz-austria.at
# Optional: Verwaltung (/admin und /api/admin) nur von diesen IPs/Netzen, mit Leerzeichen getrennt. Leer = überall (Login schützt).
ADMIN_ALLOW_IPS=
# Optional, Testbetrieb: Passwortabfrage vor der ganzen Seite (nur Mario und Techniker), Seite wird nicht indexiert.
# Hash erzeugen: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'DEIN-PASSWORT'   (leer = Seite offen)
BASIC_AUTH_USER=
BASIC_AUTH_HASH=
# Optional: direkter APK-Link für die Website (Seite /app und Startseite)
NEXT_PUBLIC_ANDROID_APK_URL=
# Optional: fertige Images statt lokalem Build (siehe docs/BETRIEB.md)
# API_IMAGE=ghcr.io/cykruz/bodenschutz-api:latest
# WEB_IMAGE=ghcr.io/cykruz/bodenschutz-web:latest
# Optional: rclone-Ziel für Backups, z. B. "hetzner:bodenschutz-backups" (leer = nur lokal)
BACKUP_RCLONE_REMOTE=
